# Dependencies and package managers
# pnpm-lock.yaml is authoritative; never commit another manager's lockfile.
node_modules/
.pnpm-store/
package-lock.json
yarn.lock
bun.lock
bun.lockb
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Expo and Metro
.expo/
.expo-shared/
dist/
web-build/
.metro-health-check*
*.orig.*

# Generated native projects (expo prebuild)
/android/
/ios/

# Native build output, including local Expo modules
**/build/
**/.gradle/
**/.cxx/
**/.externalNativeBuild/
**/.kotlin/
local.properties
*.hprof
**/Pods/
**/DerivedData/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Release artifacts
*.apk
*.aab
*.apks
*.ipa
*.xcarchive
*.dSYM
*.dSYM.zip

# Fetched or licensed native payloads (prepared locally, never committed)
modules/show-downloads/android/src/main/assets/showcontrol-yt-dlp
modules/show-downloads/android/src/main/assets/showcontrol-music/
modules/show-controller/ios/Vendor/*.xcframework/

# Music library packages exceed GitHub's 100 MB file limit; keep them locally.
# Builds skip included music when they are absent.
music-library/*.zip

# Signing, credentials, and secrets
*.jks
*.keystore
*.mobileprovision
*.p8
*.p12
*.cer
*.pem
credentials.json
/credentials/
.sentryclirc
**/sentry.properties
*.env
*.env.*
!.env.example

# Tests, coverage, and local QA runs
# Committed QA evidence lives under docs/qa/evidence/, so *.log is not ignored globally.
coverage/
.native-check/
*.tsbuildinfo
.eslintcache

# Python helpers in tools/
__pycache__/
*.py[cod]
.venv/
venv/

# Temporary files
*.tmp
*.temp

# Editors and local agent settings
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
.claude/settings.local.json
.claude/worktrees/

# Operating systems
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

