{
  "name": "show-control-app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.16.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:downloads": "node scripts/prepare-downloader.mjs",
    "prepare:speech": "node scripts/prepare-whisper.mjs",
    "prepare:speech:ios": "node scripts/prepare-whisper.mjs --ios",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:architecture": "jest tests/architecture --runInBand",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:architecture && pnpm run check:translations && node scripts/generate-tokens.mjs --check && pnpm dlx expo-doctor",
    "export:android": "expo export --platform android --output-dir dist/android",
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "check:translations": "node scripts/check-translations.mjs"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@expo-google-fonts/geist": "0.4.2",
    "@expo-google-fonts/geist-mono": "0.4.3",
    "@expo-google-fonts/heebo": "0.4.2",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.31",
    "expo-battery": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.29",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "fflate": "0.8.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^24.3.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  }
}
